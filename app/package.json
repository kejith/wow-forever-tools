{
  "name": "wow-forever-tools",
  "productName": "WoW Forever Tools",
  "version": "1.9.1",
  "private": true,
  "description": "Desktop app for WoW: Forever: installs the WoWMCP and GoldPerHour addons and shows character, writs, AH upgrades, professions and gold per hour.",
  "author": "kejith",
  "homepage": "https://github.com/kejith/wow-forever-tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/kejith/wow-forever-tools.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "capture": "electron . --capture=captures",
    "test": "node addon.test.js && node i18n.test.js",
    "dist": "electron-builder --win nsis --publish never",
    "pack": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.kejith.wowforevertools",
    "productName": "WoW Forever Tools",
    "copyright": "Copyright © 2026 kejith",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "*.js",
      "!*.test.js",
      "locales/**",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../scripts",
        "to": "scripts",
        "filter": [
          "*.py",
          "data/**",
          "!test_*.py"
        ]
      },
      {
        "from": "build/bin",
        "to": "bin",
        "filter": [
          "uv",
          "uv.exe",
          "simforever",
          "simforever.exe"
        ]
      }
    ],
    "asar": true,
    "artifactName": "WoW-Forever-Tools-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "WoW-Forever-Tools-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "publish": null
  }
}
